# Streamlit Community Cloud 배포 시 이 파일을 참고해 Secrets를 설정하세요.
# App Settings → Secrets 메뉴에 아래 내용을 복사·붙여넣기 후 실제 값으로 교체합니다.
# 이 파일(.example)은 git에 커밋해도 안전합니다.

# ── 접근 비밀번호 ─────────────────────────────────────────────────────────
DASHBOARD_PASSWORD = "팀원공유용비밀번호"   # 조회 전용 (팀원)
ADMIN_PASSWORD     = "관리자비밀번호"       # 전체 접근 (데이터 수집 포함)

# ── Analytics DB (Supabase) ───────────────────────────────────────────────
DB_SUPABASE_URL        = "https://xxxx.supabase.co"
DB_SUPABASE_SERVICE_KEY = "sb_secret_..."

# ── Meta Ads ──────────────────────────────────────────────────────────────
META_ACCESS_TOKEN_A = "Bearer EAA..."
META_ACCESS_TOKEN_B = "Bearer EAA..."
META_AD_ACCOUNT_A   = "act_1292362411878252"
META_AD_ACCOUNT_B   = "act_3110366275814489"
META_AD_ACCOUNT_C   = "act_1579306933279906"

# ── Google Ads ────────────────────────────────────────────────────────────
GOOGLE_DEVELOPER_TOKEN = ""
GOOGLE_CLIENT_ID       = ""
GOOGLE_CLIENT_SECRET   = ""
GOOGLE_REFRESH_TOKEN   = ""
GOOGLE_MCC_ID          = "4607905919"
